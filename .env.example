# FinanceAI Environment Configuration

# Application
APP_NAME=FinanceAI
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database (defaults to SQLite local db in backend/financeai.db)
DATABASE_URL=sqlite:///./financeai.db

# LLM Providers (Optional - built-in financial analysis engine operates automatically if keys are absent)
AI_PROVIDER=local
# Options: local | openai | groq | ollama

# OpenAI Configuration (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq Configuration (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Configuration (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Financial Data Providers
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=

# Cache Settings
CACHE_TTL_SECONDS=300
